OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

SPRING_BASE_URL=http://localhost:8080
SPRING_INTERNAL_KEY=your-internal-key

# GUARDIAN_NOTIFY 후 EMERGENCY_CALL 진행 전 보호자 확인 대기 (기본 60초)
EMERGENCY_CALL_DELAY_SECONDS=60

# 모델 런타임 — false면 로드를 건너뛴다 (에이전트만 개발할 때)
NOTIFI_MODEL_ENABLED=true
# 아래 3개는 설정하지 않으면 기본 동작(cuda 우선 자동 선택, 패키지 artifacts, <repo>/runtime/devices).
# 빈 값으로 두지 말고 필요할 때만 주석을 풀어라 — 빈 문자열은 기본값이 아니라 잘못된 경로로 해석된다.
# NOTIFI_MODEL_DEVICE=cpu
# NOTIFI_ARTIFACT_DIR=C:/path/to/NotiFi_AI_v1/artifacts
# NOTIFI_REGISTRY_ROOT=C:/path/to/runtime/devices
